#!/bin/sh
# Enforce Speed Bay commit hygiene on every commit the agent makes:
# strip AI-attribution trailers, then require the Linear closing line.
#
# warehouse's AGENTS.md forbids AI attribution, but upstream's collaboration
# prompt instructs the model to append `Co-authored-by: open-swe[bot]` verbatim.
# Prompt-level instructions lose that argument roughly half the time, so this
# hook enforces it deterministically instead. Registered via core.hooksPath in
# speedbay/run-dev.sh, so it applies to any repo the sandbox clones.
set -eu

MSG_FILE="$1"

# Drop the bot trailer and the Open SWE generated-by credit — and only those.
# Patterns stay anchored to the open-swe attribution so legitimate lines like
# "Generated with deterministic seed" survive.
grep -viE '^(co-authored-by:[[:space:]]*open-swe\[bot\][[:space:]]*<open-swe@users\.noreply\.github\.com>[[:space:]]*|generated with \[open swe\]\(https://github\.com/langchain-ai/open-swe\)[[:space:]]*|made by \[open swe\]\(https://github\.com/langchain-ai/open-swe\)[[:space:]]*)$' \
	"$MSG_FILE" > "$MSG_FILE.tmp" || true

# Collapse the trailing blank lines the removal leaves behind, without relying
# on GNU-specific tooling.
awk 'BEGIN{blank=0} {if ($0 ~ /^[[:space:]]*$/) {blank++} else {while (blank>0) {print ""; blank--}; print}}' \
	"$MSG_FILE.tmp" > "$MSG_FILE"

rm -f "$MSG_FILE.tmp"

# Require the Linear closing line (Agent Hygiene CRA rule 2 / warehouse
# COMMIT-HYGIENE). The conventions prompt already asks for it, but prompt-level
# instructions lose intermittently (see above), so enforce it deterministically.
if ! grep -qE '^Closes [A-Z]+-[0-9]+$' "$MSG_FILE"; then
	echo "commit-msg: missing 'Closes <TEAM>-NNN' line in the commit body." >&2
	echo "Add it (e.g. 'Closes OPE-58') on its own line before the first '## ' heading." >&2
	exit 1
fi
