#!/bin/sh
# `gh` shim that replaces the hardcoded dummy token with a real one.
#
# Open SWE's prompts instruct the agent to run `GH_TOKEN=dummy gh ...`, on the
# assumption that a sandbox proxy rewrites the credential. The local backend has
# no proxy, so the literal "dummy" reaches GitHub and every call 401s. This shim
# sits earlier on PATH than the real gh and swaps in an installation token.
set -eu

HERE="$(cd -P "$(dirname "$0")" && pwd)"

canonical_path() {
	path="$1"
	while [ -L "$path" ]; do
		directory="$(cd -P "$(dirname "$path")" && pwd)"
		link="$(readlink "$path")"
		case "$link" in
		/*) path="$link" ;;
		*) path="$directory/$link" ;;
		esac
	done
	printf '%s/%s\n' "$(cd -P "$(dirname "$path")" && pwd)" "$(basename "$path")"
}

SHIM="$(canonical_path "$HERE/gh")"
REAL_GH=""
remaining_path="${PATH:-}:"
while [ -n "$remaining_path" ]; do
	directory="${remaining_path%%:*}"
	remaining_path="${remaining_path#*:}"
	[ -n "$directory" ] || directory=.
	candidate="$directory/gh"
	if [ -f "$candidate" ] && [ -x "$candidate" ] && [ "$(canonical_path "$candidate")" != "$SHIM" ]; then
		REAL_GH="$candidate"
		break
	fi
done

if [ -z "$REAL_GH" ]; then
	echo "FAIL: no real gh executable found on PATH" >&2
	exit 127
fi

# Mint only when the token is absent, empty, or the prompt's literal "dummy".
# A deliberately supplied real GH_TOKEN passes through untouched — the agent
# may need an identity outside the GitHub App installation.
if [ "${GH_TOKEN:-dummy}" = "dummy" ]; then
	GH_TOKEN="$("$HERE/../../.venv/bin/python" "$HERE/../mint_token.py")"
	export GH_TOKEN
	unset GITHUB_TOKEN 2>/dev/null || true
fi

exec "$REAL_GH" "$@"
